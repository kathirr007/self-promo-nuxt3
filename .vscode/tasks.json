{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Kiro Chat",
      "type": "shell",
      "command": "kiro-cli",
      "args": ["chat"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
